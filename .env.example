# Contrasena de emergencia del servidor. Nunca usar el prefijo NEXT_PUBLIC.
APP_PASSWORD=TuContrasenaAqui

# Google Gemini API Key (requerido para el Asistente AK con IA)
# Obtener en: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Modelo Gemini para los flujos del Asistente AK
# Debe tener formato: googleai/gemini-<version>
# Ejemplo vigente: googleai/gemini-3.6-flash
# Fallback actual del codigo: googleai/gemini-3.6-flash
GEMINI_MODEL=googleai/gemini-3.6-flash

# Modelos opcionales por tipo de agente
# Si quedan vacios, se usa el modelo estable configurado para cada flujo.
GEMINI_MODEL_FAST=googleai/gemini-3.6-flash
GEMINI_MODEL_PRO=googleai/gemini-3.6-flash
GEMINI_MODEL_MARKETING=googleai/gemini-3.6-flash
GEMINI_MODEL_COMMERCIAL=googleai/gemini-3.6-flash
GEMINI_IMAGE_MODEL=googleai/gemini-3.1-flash-image

# Firebase Data Mode
USE_FIREBASE_DATA=true

# Firebase config (get these from Firebase Console -> Project Settings -> Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=presupuestador-ak-producciones
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public URL of the app
# Fallback: window.location.origin
# NEXT_PUBLIC_APP_URL=https://ak-producciones--presupuestador-ak-producciones.us-east4.hosted.app

# Google Workspace: Calendar + Gmail
# Crear credenciales OAuth en Google Cloud y agregar esta app como redirect autorizado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_PATH=/api/google/oauth/callback
GOOGLE_WORKSPACE_CALENDAR_ID=primary
GOOGLE_WORKSPACE_SEND_UPDATES=all
# Local browser tests can read repository JSON fixtures without contacting Firestore.
# Never enable this in production.
AK_USE_LOCAL_JSON_ONLY=false
