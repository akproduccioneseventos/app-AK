# Contraseña de acceso a la app (autenticación simple de contraseña compartida)
NEXT_PUBLIC_APP_PASSWORD=TuContraseñaAquí

# Google Gemini API Key (requerido para el Asistente AK con IA)
# Obtener en: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Firebase Data Mode
USE_FIREBASE_DATA=true

# Firebase config (get these from Firebase Console → Project Settings → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=presupuestador-ak-producciones
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public URL of the app
# Fallback: window.location.origin
# NEXT_PUBLIC_APP_URL=https://ak-producciones--presupuestador-ak-producciones.us-east4.hosted.app
