# ── Firebase (client-side) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=presupuestador-ak-producciones
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Data Mode ──
USE_FIREBASE_DATA=true

# ── Google Gemini API Key (for AK Assistant) ──
# Get at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# ── Session signing secret ──
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# ── Admin bootstrap (ONLY used on first deploy when no users exist) ──
ADMIN_BOOTSTRAP_EMAIL=admin@akproducciones.uy
ADMIN_BOOTSTRAP_PASSWORD=

# ── Public URL ──
# NEXT_PUBLIC_APP_URL=https://akproducciones.uy

# ── NEVER set in production ──
# NEXT_PUBLIC_E2E=true
