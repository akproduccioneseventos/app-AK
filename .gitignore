# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# graphify
graphify-out/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.genkit/*
.env*
!.env.example

# firebase
firebase-debug.log
firestore-debug.log

# contracts uploaded by users
src/data/contracts/*.pdf

# price adjustment history (generated at runtime)
price-adjustments-history.json

# conexiones de redes: guarda el permiso de publicacion de Facebook e Instagram.
# Ese permiso deja publicar en las cuentas de la empresa, asi que el archivo no
# puede viajar al repositorio.
src/data/social-connections.json
src/data/google_service_account.json
src/data/*service-account*.json

# La configuracion con las llaves de la empresa NO se versiona.
#
# Aca adentro terminan la llave de cobros de Mercado Pago, la de medicion y la de
# los anuncios. La de cobros mueve plata de verdad: si viaja en el repositorio,
# queda en el historial para siempre aunque despues se borre el archivo.
#
# Va en la consola del servidor, no en un archivo del proyecto.
src/data/settings.json
src/data/google-workspace.json

# backup files
src/data/last-auto-backup.txt

# Datos que ESCRIBE la app al correr, no configuracion. Aparecen solos al probar
# en local y **no se commitean nunca**: commitearlos pisaria en produccion el
# contador de gasto de inteligencia artificial y el historial de numeros de redes
# con lo que quedo de una corrida de prueba.
data/ai-consumo.json
src/data/ai-consumo.json
data/digital-presence-review.json
src/data/digital-presence-review.json
data/social-analytics-history.json
src/data/social-analytics-history.json
data/tareas-al-entrar-estado.json
src/data/tareas-al-entrar-estado.json
data/whatsapp-conversaciones-de-publicidad.json
src/data/whatsapp-conversaciones-de-publicidad.json

# abacus
.abacus.donotdeletepackage-lock.json

# PWA generated files (generated at build time by @ducanh2912/next-pwa)
/public/sw.js
/public/workbox-*.js
/public/sw.js.map
/public/workbox-*.js.map

# Playwright E2E test artifacts
/playwright-report/
/test-results/
/playwright/.auth/
/tmp/
functions/package-lock.json

# graphify
/graphify-out/


# Eventos de prueba creados por el viaje del invitado (se borran solos).
data/fiestas/e2e_*.json
src/data/fiestas/e2e_*.json

# Datos que generan las pruebas de la noche de fiesta (no son del proyecto).
data/fiestas/
src/data/fiestas/

# Fotos de pantallas para revisar a ojo, no van al repositorio
capturas/

# El informe de `npm run auditoria` se genera cada vez y trae la hora adentro.
# Estaba versionado, y como la prueba del script tambien lo escribe, CADA corrida
# de pruebas dejaba el repositorio sucio y trababa a las tres IA que trabajan acá.
# Se genera cuando se necesita; lo que vale son los cuatro numeros del resumen.
auditoria-out/
