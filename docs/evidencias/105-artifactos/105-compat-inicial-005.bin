  1  | import { expect, test, type Locator } from '@playwright/test';
  2  | import { ponerSesionDelEquipo } from './helpers/fiesta-de-prueba';
  3  | 
  4  | test.skip(process.env.AK_ENTORNO_AISLADO !== 'true', 'Solo entorno aislado, sin cuentas reales');
  5  | const monthName = /^(enero|febrero|marzo|abril|mayo|junio|julio|agosto|septiembre|octubre|noviembre|diciembre) \d{4}$/;
  6  | 
  7  | async function headerDoesNotOverlap(caption: Locator, next: Locator) {
  8  |   const label = await caption.boundingBox();
  9  |   const button = await next.boundingBox();
  10 |   expect(label).not.toBeNull();
  11 |   expect(button).not.toBeNull();
  12 |   if (label && button) {
  13 |     const overlapX = Math.min(label.x + label.width, button.x + button.width) - Math.max(label.x, button.x);
  14 |     const overlapY = Math.min(label.y + label.height, button.y + button.height) - Math.max(label.y, button.y);
  15 |     expect(overlapX > 0 && overlapY > 0, 'El mes no tapa el control de navegacion').toBe(false);
  16 |   }
  17 | }
  18 | 
  19 | test('agenda: elegir dia y navegar meses sin tapar los controles', async ({ page, context, baseURL }, info) => {
  20 |   await ponerSesionDelEquipo(context, baseURL);
  21 |   await page.goto('/contabilidad/crm/agenda', { waitUntil: 'domcontentloaded' });
  22 |   const grid = page.getByRole('grid').first();
  23 |   await expect(grid).toBeVisible();
  24 |   const caption = page.getByText(monthName, { exact: true }).first();
  25 |   const next = page.getByRole('button', { name: 'Ir al mes siguiente' });
  26 |   await headerDoesNotOverlap(caption, next);
  27 |   await headerDoesNotOverlap(caption, page.getByRole('button', { name: 'Ir al mes anterior' }));
  28 |   const initialMonth = await caption.textContent();
  29 |   await next.click();
  30 |   await expect(caption).not.toHaveText(initialMonth!);
  31 |   const selectedDay = grid.locator('td[data-day]:not([data-outside]) button').filter({ hasText: /^9$/ }).first();
  32 |   await selectedDay.click();
  33 |   await expect(selectedDay.locator('..')).toHaveAttribute('aria-selected', 'true');
  34 |   await expect(page.getByText(/^Reuniones para:/)).toContainText('9');
  35 |   await info.attach('agenda-calendario.png', { body: await grid.locator('..').screenshot(), contentType: 'image/png' });
  36 | });
  37 | 
  38 | test('redes: calendario visible y navegacion mensual', async ({ page, context, baseURL }, info) => {
  39 |   await ponerSesionDelEquipo(context, baseURL);
  40 |   await page.goto('/empresa/redes-sociales', { waitUntil: 'domcontentloaded' });
  41 |   await page.getByRole('tab', { name: 'Calendario', exact: true }).click();
  42 |   const panel = page.getByRole('tabpanel');
  43 |   await expect(panel.getByRole('grid')).toBeVisible();
  44 |   const caption = panel.getByText(monthName, { exact: true });
  45 |   const next = panel.getByRole('button', { name: 'Ir al mes siguiente' });
  46 |   await headerDoesNotOverlap(caption, next);
  47 |   await headerDoesNotOverlap(caption, panel.getByRole('button', { name: 'Ir al mes anterior' }));
  48 |   const initialMonth = await caption.textContent();
> 49 |   await next.click();
