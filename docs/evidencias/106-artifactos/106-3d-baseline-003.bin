# Test source

```ts
  1  | import { expect, test, type Page } from '@playwright/test';
  2  | import { ponerSesionDelEquipo } from './helpers/fiesta-de-prueba';
  3  | 
  4  | test.skip(process.env.AK_ENTORNO_AISLADO !== 'true', 'Solo entorno aislado');
  5  | 
  6  | async function imagen(page: Page) {
  7  |   return page.locator('canvas').first().evaluate((canvas: HTMLCanvasElement) => canvas.toDataURL());
  8  | }
  9  | 
  10 | test.beforeEach(async ({ page, context, baseURL }) => {
  11 |   test.setTimeout(120000);
  12 |   await ponerSesionDelEquipo(context, baseURL);
  13 |   await page.goto('/empresa/configurador-reunion', { waitUntil: 'domcontentloaded' });
  14 |   const canvas = page.locator('canvas').first();
  15 |   await expect(canvas).toBeVisible({ timeout: 60000 });
  16 |   await canvas.scrollIntoViewIfNeeded();
  17 |   await expect.poll(() => canvas.evaluate((node: HTMLCanvasElement) => node.width)).toBeGreaterThan(100);
  18 |   await page.waitForTimeout(1500);
  19 | });
  20 | 
  21 | test('la ayuda queda fuera del lienzo y la navegacion no esta tapada', async ({ page }, info) => {
  22 |   const help = page.getByText(/Arrastr.*para rotar la c.mara 3D/);
  23 |   await expect(help).toBeVisible();
  24 |   const helpBox = await help.boundingBox();
