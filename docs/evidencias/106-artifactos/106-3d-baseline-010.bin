# Test source

```ts
  1  | import { expect, test, type Page } from '@playwright/test';
  2  | import { ponerSesionDelEquipo } from './helpers/fiesta-de-prueba';
  3  | 
  4  | test.skip(process.env.AK_ENTORNO_AISLADO !== 'true', 'Solo entorno aislado');
  5  | 
  6  | async function imagen(page: Page) {
  7  |   return page.locator('canvas').first().evaluate((canvas: HTMLCanvasElement) => canvas.toDataURL());
  8  | }
  9  | 
  10 | test.beforeEach(async ({ page, context, baseURL }) => {
  11 |   test.setTimeout(120000);
  12 |   await ponerSesionDelEquipo(context, baseURL);
  13 |   await page.goto('/empresa/configurador-reunion', { waitUntil: 'domcontentloaded' });
  14 |   const canvas = page.locator('canvas').first();
  15 |   await expect(canvas).toBeVisible({ timeout: 60000 });
  16 |   await canvas.scrollIntoViewIfNeeded();
  17 |   await expect.poll(() => canvas.evaluate((node: HTMLCanvasElement) => node.width)).toBeGreaterThan(100);
  18 |   await page.waitForTimeout(1500);
  19 | });
  20 | 
  21 | test('la ayuda queda fuera del lienzo y la navegacion no esta tapada', async ({ page }, info) => {
  22 |   const help = page.getByText(/Arrastr.*para rotar la c.mara 3D/);
  23 |   await expect(help).toBeVisible();
  24 |   const helpBox = await help.boundingBox();
  25 |   const canvasBox = await page.locator('canvas').first().boundingBox();
  26 |   if (!helpBox || !canvasBox) throw new Error('Ayuda/lienzo sin medidas');
  27 |   await info.attach('ayuda-lienzo.json', { body: JSON.stringify({ helpBox, canvasBox }), contentType: 'application/json' });
  28 |   await info.attach('ayuda-lienzo.png', { body: await page.screenshot(), contentType: 'image/png' });
> 29 |   expect(helpBox.y + helpBox.height, 'La ayuda no tapa la escena').toBeLessThanOrEqual(canvasBox.y + 1);
     |                                                                    ^ Error: La ayuda no tapa la escena
  30 |   const nav = page.getByRole('navigation', { name: 'Navegacion del modulo' });
  31 |   for (const button of await nav.getByRole('button').all()) {
  32 |     await expect(button).toBeVisible();
  33 |     expect(await button.evaluate(node => {
  34 |       const box = node.getBoundingClientRect();
  35 |       return node.contains(document.elementFromPoint(box.x + box.width / 2, box.y + box.height / 2));
  36 |     }), 'El boton flotante recibe el toque').toBe(true);
  37 |   }
  38 | });
  39 | 
  40 | test('Recorrer mueve la escena sin arrastrar y se puede pausar', async ({ page }, info) => {
  41 |   const button = page.getByRole('button', { name: 'Recorrer', exact: true });
  42 |   await button.click();
  43 |   await page.locator('canvas').first().scrollIntoViewIfNeeded();
  44 |   await page.waitForTimeout(1200);
  45 |   const before = await imagen(page);
  46 |   await page.waitForTimeout(1600);
  47 |   const moving = await imagen(page);
  48 |   await info.attach('recorrido-automatico.json', { body: JSON.stringify({ changed: before !== moving }), contentType: 'application/json' });
  49 |   expect(moving !== before, 'Recorrer debe mover la camara, no solo su icono').toBe(true);
  50 |   const pause = page.getByRole('button', { name: 'Pausar recorrido', exact: true });
  51 |   await expect(pause).toHaveAttribute('aria-pressed', 'true');
  52 |   await pause.click();
  53 |   await page.locator('canvas').first().scrollIntoViewIfNeeded();
  54 |   await page.waitForTimeout(1800);
  55 |   const stopped = await imagen(page);
  56 |   await page.waitForTimeout(1000);
  57 |   expect(await imagen(page) === stopped, 'Pausar detiene el giro automatico').toBe(true);
  58 |   await expect(page.getByRole('button', { name: 'Recorrer', exact: true })).toHaveAttribute('aria-pressed', 'false');
  59 | });
  60 | 
