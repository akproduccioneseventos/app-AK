  30  |   await expect(canvas).toBeVisible({ timeout: 60000 });
  31  |   await canvas.scrollIntoViewIfNeeded();
  32  |   await expect.poll(() => canvas.evaluate((node: HTMLCanvasElement) => node.width)).toBeGreaterThan(100);
  33  |   await page.waitForTimeout(1500);
  34  | });
