# Test source

```ts
  1  | import { expect, test, type Page } from '@playwright/test';
  2  | import { ponerSesionDelEquipo } from './helpers/fiesta-de-prueba';
  3  | 
  4  | test.skip(process.env.AK_ENTORNO_AISLADO !== 'true', 'Solo entorno aislado');
  5  | 
  6  | async function imagen(page: Page) {
  7  |   return page.locator('canvas').first().evaluate((canvas: HTMLCanvasElement) => {
  8  |     const sample = document.createElement('canvas');
  9  |     sample.width = 96; sample.height = 96;
  10 |     const reader = sample.getContext('2d');
  11 |     if (!reader) throw new Error('No hay lector de pixeles');
  12 |     reader.drawImage(canvas, 0, 0, 96, 96);
  13 |     return Array.from(reader.getImageData(0, 0, 96, 96).data);
  14 |   });
  15 | }
  16 | 
  17 | function cambio(before: number[], after: number[]) {
  18 |   let changed = 0;
  19 |   for (let i = 0; i < before.length; i += 4) {
  20 |     if ([0, 1, 2].some(channel => Math.abs(before[i + channel] - after[i + channel]) > 4)) changed++;
  21 |   }
  22 |   return changed / (before.length / 4);
  23 | }
  24 | 
  25 | test.beforeEach(async ({ page, context, baseURL }) => {
  26 |   test.setTimeout(120000);
  27 |   await ponerSesionDelEquipo(context, baseURL);
  28 |   await page.goto('/empresa/configurador-reunion', { waitUntil: 'domcontentloaded' });
  29 |   const canvas = page.locator('canvas').first();
