               const txt = (el.textContent || '').trim();
               if (['P', 'H1', 'H2', 'H3', 'H4'].includes(el.tagName) && txt.split(/\s+/).length > 3 && rect.width < 90) {
                 errs.push(`palabra-por-palabra: ${el.tagName} (${Math.round(rect.width)}px)`);
