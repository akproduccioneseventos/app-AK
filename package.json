    "firebase": "^11.5.0",
    "firebase-admin": "^13.7.0",
    "framer-motion": "^11.2.12",
    "genkit": "1.20.0",
    "googleapis": "176.0.0",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "jspdf": "4.2.1",
    "jszip": "^3.10.1",
    "lodash": "^4.18.1",
    "lucide-react": "^0.480.0",
    "next": "15.5.23",
    "qrcode.react": "^3.1.0",
    "rdndmb-html5-to-touch": "^9.0.0",
    "react": "^18.3.1",
