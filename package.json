{
  "name": "ak-producciones",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-firebase-messaging-sw.mjs && node scripts/build-next-with-memory.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit",
    "test": "jest",
    "quality:quick": "npm run lint && npm run typecheck",
    "quality:full": "npm run quality:quick && npm run test",
    "quality:security": "npm run test:rules",
    "quality:all": "npm run quality:full && npm run quality:security && npm run test:e2e:production",
    "test:e2e": "node scripts/run-playwright-production.mjs",
    "test:e2e:lento": "playwright test",
    "test:e2e:production": "npm run build && node scripts/run-playwright-production.mjs",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:rules": "node ./node_modules/firebase-tools/lib/bin/firebase.js emulators:exec --only firestore --project demo-ak-producciones \"node ./node_modules/jest/bin/jest.js --runInBand --config jest.rules.config.js\"",
    "check:acentos": "node scripts/check-acentos.mjs",
    "auditoria": "node scripts/auditoria.mjs",
    "mapa:generar": "node scripts/generar-mapa-app.mjs",
    "audit:dead-code": "knip --production",
    "graphify:update": "uv tool run --from graphifyy graphify extract . && uv tool run --from graphifyy graphify cluster-only .",
    "smoke:browser": "node scripts/ak-browser-smoke.mjs",
    "firebase:emulators": "firebase emulators:start --project presupuestador-ak-producciones",
    "firebase:migrate": "npx tsx src/scripts/migrate-to-firebase.ts",
    "firebase:migrate:verify": "npx tsx src/scripts/migrate-to-firebase.ts --verify",
    "firebase:verify": "npx tsx src/scripts/migrate-to-firebase.ts verify",
    "dev:firebase": "concurrently \"firebase emulators:start --project presupuestador-ak-producciones\" \"next dev\"",
    "build:functions": "cd functions && npm install && npm run build",
    "dev:local": "concurrently \"next dev\" \"firebase emulators:start --only firestore,auth,functions,hosting --project presupuestador-ak-producciones\"",
    "predeploy:functions": "npm run build && npm run build:functions && cp -r .next functions/.next && cp -r public functions/public",
    "deploy:functions": "npm run predeploy:functions && firebase deploy --only functions,hosting --project presupuestador-ak-producciones",
    "publicar?": "node scripts/se-puede-publicar.mjs",
    "lo-que-se-dijo": "node scripts/lo-que-se-dijo-es-lo-que-es.mjs",
    "lo-que-se-dijo:todo": "node scripts/lo-que-se-dijo-es-lo-que-es.mjs --todo",
    "publicar?:rapido": "node scripts/se-puede-publicar.mjs --rapido",
    "recorrido": "node scripts/recorrido-de-pantallas.mjs",
    "conexiones?": "node scripts/conexiones-estado.mjs",
    "estetica?": "node scripts/control-estetica.mjs",
    "auditado": "node scripts/actualizar-auditado.mjs",
    "prepare": "node scripts/instalar-filtro.mjs",
    "filtro": "node scripts/se-puede-publicar.mjs --filtro",
    "limpiar:corrida": "node scripts/limpiar-corrida.mjs",
    "ordenes?": "node scripts/ordenes-cumplidas.mjs",
    "recorrido:todo": "node scripts/recorrido-de-pantallas.mjs --todo"
  },
  "dependencies": {
