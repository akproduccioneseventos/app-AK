{
  "name": "ak-producciones",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "firebase:emulators": "firebase emulators:start --project presupuestador-ak-producciones",
    "firebase:migrate": "npx tsx src/scripts/migrate-to-firebase.ts",
    "firebase:migrate:verify": "npx tsx src/scripts/migrate-to-firebase.ts --verify",
    "firebase:verify": "npx tsx src/scripts/migrate-to-firebase.ts verify",
    "dev:firebase": "concurrently \"firebase emulators:start --project presupuestador-ak-producciones\" \"next dev\"",
    "build:functions": "cd functions && npm install && npm run build",
    "dev:local": "concurrently \"next dev\" \"firebase emulators:start --only firestore,auth,functions,hosting --project presupuestador-ak-producciones\"",
    "predeploy:functions": "npm run build && npm run build:functions && cp -r .next functions/.next && cp -r public functions/public",
    "deploy:functions": "npm run predeploy:functions && firebase deploy --only functions,hosting --project presupuestador-ak-producciones"
  },
