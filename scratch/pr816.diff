+/**
+ * Tracks custom marketing events in Google Analytics (GA4).
+ */
+export function trackGaEvent(
+  action: string,
+  params: {
+    category?: string;
+    label?: string;
+    value?: number;
+    [key: string]: any;
+  } = {}
+) {
+  if (typeof window !== 'undefined' && window.gtag) {
+    window.gtag('event', action, {
