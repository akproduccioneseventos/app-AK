+
+    let cancelledCount = 0;
+    for (const msg of pending) {
+      const res = await cancelScheduledMessage(msg.id, `Autocancelado: ${reason}`);
+      if (res.success) cancelledCount++;
+    }
+    return { cancelledCount };
+  } catch {
+    return { cancelledCount: 0 };
+  }
