rules_version = '2';
// SOLO para el emulador de pruebas (firebase.pruebas.json). No se despliega: firebase.json no lo
// nombra. Deja leer las fotos de prueba para que el navegador las muestre; escribir, solo el
// servidor (que no pasa por estas reglas).
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
